org.h2.jdbc.JdbcSQLSyntaxErrorException: Ambiguous column name "ID"; SQL statement:
DELETE FROM planning 
WHERE id IN (
    SELECT id FROM (
        SELECT 
            id,
            ROW_NUMBER() OVER (
                PARTITION BY s.client_id, p.num_visite 
                ORDER BY 
                    CASE WHEN p.statut = 'ACCEPTE' THEN 1
                         WHEN p.statut = 'CONFIRME' THEN 2
                         WHEN p.statut = 'REALISE' THEN 3
                         ELSE 4 END,
                    p.id DESC
            ) as rn
        FROM planning p
        JOIN site s ON p.site_id = s.id
        WHERE p.statut != 'ANNULE'
    ) t 
    WHERE rn > 1
) [90059-214]
